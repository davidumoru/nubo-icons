{
  "name": "nubo-icons-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "icons:lint": "pnpm --filter @nubo-icons/tools lint",
    "icons:preview": "pnpm --filter @nubo-icons/tools preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "test": "pnpm --filter \"./packages/**\" test",
    "changeset": "changeset",
    "release": "pnpm build && node scripts/stage-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.9"
  }
}
